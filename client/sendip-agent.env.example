# 客户端环境变量示例，复制到 /etc/send-ip-agent.env 后修改，权限设为 600
# sudo cp deploy/sendip-agent.env.example /etc/send-ip-agent.env
# sudo chmod 600 /etc/send-ip-agent.env

# 服务端接收地址（必填），生产环境用 HTTPS
# 注意结尾必须是 receive-ip，不是页面地址！
#   对：https://hexoo.me/ip/receive-ip
#   错：https://hexoo.me/ip/          ← POST 到页面会返回 405
# 若填成以 / 结尾的基础地址，客户端会自动补上 receive-ip 并打印提示
SENDIP_DOMAIN=https://ip.example.com/receive-ip

# 与服务端 APP_TOKEN 完全一致，注意别带引号和多余空格
SENDIP_TOKEN=please-change-me-to-a-random-string

# 上报间隔秒数，默认 3600（1 小时），最小 60
SENDIP_INTERVAL=3600
