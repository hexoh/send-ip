# Client environment variable example; copy to /etc/send-ip-agent.env, edit it, and set mode 600
# sudo cp deploy/sendip-agent.env.example /etc/send-ip-agent.env
# sudo chmod 600 /etc/send-ip-agent.env

# Server receiving address (required); use HTTPS in production
# The path must end with receive-ip, not the page address!
#   Right: https://hexoo.me/ip/receive-ip
#   Wrong: https://hexoo.me/ip/          <- POSTing to the page returns 405
# If you enter a base address ending in /, the client appends receive-ip automatically and logs a warning
SENDIP_DOMAIN=https://ip.example.com/receive-ip

# Must exactly match the server's APP_TOKEN; do not add quotes or extra spaces
SENDIP_TOKEN=please-change-me-to-a-random-string

# Reporting interval in seconds, defaults to 3600 (1 hour), minimum 60
SENDIP_INTERVAL=3600
