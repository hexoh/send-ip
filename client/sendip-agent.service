[Unit]
Description=send-ip agent (定时上报本机公网 IP)
Documentation=https://github.com/hexoh/send-ip
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 按实际运行用户修改，root 也可以但建议用普通用户
User=nobody
Group=nogroup
WorkingDirectory=/opt/send-ip-agent

EnvironmentFile=/etc/send-ip-agent.env
# /etc/send-ip-agent.env 内容示例：
#   SENDIP_DOMAIN=https://ip.example.com/receive-ip
#   SENDIP_TOKEN=换成你的令牌
#   SENDIP_INTERVAL=3600

ExecStart=/opt/send-ip-agent/.venv/bin/python /opt/send-ip-agent/index.py
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
