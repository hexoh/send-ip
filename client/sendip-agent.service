[Unit]
Description=Send IP Agent
Documentation=https://github.com/hexoh/send-ip
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change to the actual runtime user; root also works but a normal user is recommended
User=nobody
Group=nogroup
WorkingDirectory=/opt/send-ip-agent

EnvironmentFile=/etc/send-ip-agent.env
# Example /etc/send-ip-agent.env contents:
#   SENDIP_DOMAIN=https://ip.example.com/receive-ip
#   SENDIP_TOKEN=replace-with-your-token
#   SENDIP_INTERVAL=3600

ExecStart=/opt/send-ip-agent/.venv/bin/python /opt/send-ip-agent/index.py
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
