[Unit]
Description=Send IP Flask Service
Documentation=https://github.com/hexoh/send-ip
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/send-ip

# Sensitive config such as the token lives in /etc/send-ip.env with mode 600
EnvironmentFile=/etc/send-ip.env
Environment="DB_PATH=/var/lib/send-ip/ips.db"

ExecStart=/opt/send-ip/.venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:8000 \
    --access-logfile - \
    --error-logfile - \
    app:app

Restart=always
RestartSec=3
TimeoutStopSec=20

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/send-ip

[Install]
WantedBy=multi-user.target
