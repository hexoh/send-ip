# 服务端环境变量示例，复制到 /etc/send-ip.env 后修改，权限设为 600
# sudo cp .env.example /etc/send-ip.env && sudo chmod 600 /etc/send-ip.env

# 鉴权令牌，客户端必须带上同样的值。留空 = 不校验（只能本地调试用）
APP_TOKEN=please-change-me-to-a-random-string

# 页面访问密码：随你定，任意字符串都行（中文、符号都可以），不必是随机串。
# 留空 = 首页公开，任何人打开域名就能看到 IP（不推荐）。
# 想生成随机串：python3 -c "import secrets; print(secrets.token_urlsafe(18))"
# 值里有空格 / # / 引号时用单引号包起来：APP_PASSWORD='my pass#1'
# 首尾空格会被自动忽略。改完记得 systemctl restart sendip
APP_PASSWORD=please-change-me-to-a-long-random-password

# 站点走 HTTPS 时设为 1，登录 Cookie 只通过加密连接发送（推荐）
COOKIE_SECURE=1

# 会话 Cookie 的签名密钥：留空则自动生成到 <数据库目录>/secret.key（权限 600）
# 想让所有已登录设备立即失效，删掉那个文件即可（换密钥 = 旧 Cookie 全部作废）
# SECRET_KEY=

# 可选：登录有效期（天）、同一 IP 允许的密码错误次数、锁定时长（秒）
# SESSION_DAYS=7
# LOGIN_MAX_FAILS=5
# LOGIN_LOCK_SECONDS=600

# SQLite 数据库路径
DB_PATH=/var/lib/send-ip/ips.db
