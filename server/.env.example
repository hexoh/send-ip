# Server environment variables. Copy to /etc/send-ip.env, then edit; set permissions to 600.
# sudo cp .env.example /etc/send-ip.env && sudo chmod 600 /etc/send-ip.env

# Auth token. Clients must send the same value. Empty = no auth (local debugging only).
APP_TOKEN=please-change-me-to-a-random-string

# Page access password: any string you like (Chinese, symbols, whatever) - it need not be random.
# Empty = public homepage, anyone who opens the domain sees the IP (not recommended).
# To generate a random one: python3 -c "import secrets; print(secrets.token_urlsafe(18))"
# If the value contains spaces / # / quotes, wrap it in single quotes: APP_PASSWORD='my pass#1'
# Leading and trailing spaces are ignored. Restart with systemctl restart sendip after editing.
APP_PASSWORD=please-change-me-to-a-long-random-password

# Set to 1 when the site is served over HTTPS; the login cookie is then sent only over encrypted connections (recommended).
COOKIE_SECURE=1

# Session cookie signing key. Empty = auto-generated at <database dir>/secret.key (mode 600).
# To invalidate every logged-in device immediately, just delete that file (new key = all old cookies void).
# SECRET_KEY=

# Optional: login lifetime (days), allowed password failures per IP, lockout duration (seconds).
# SESSION_DAYS=7
# LOGIN_MAX_FAILS=5
# LOGIN_LOCK_SECONDS=600

# SQLite database path
DB_PATH=/var/lib/send-ip/ips.db
